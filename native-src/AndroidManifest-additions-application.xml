<!--
  Add these lines inside the <application> tag of
  android/app/src/main/AndroidManifest.xml (created by `npx cap add android`),
  anywhere alongside the existing <activity> entry.
-->

<!-- Foreground service backing the lock-screen / notification playback controls.
     The MEDIA_BUTTON intent-filter is required: it's what lets
     androidx.media.session.MediaButtonReceiver (below) find this exact
     service and forward button presses to it. Without this filter,
     MediaButtonReceiver falls through to a MediaBrowserServiceCompat lookup
     that finds nothing and throws, crashing the app the instant any
     notification/lock-screen button (Play, Previous, Next) is tapped. -->
<service
    android:name="com.francistech.vinylist.MediaPlaybackService"
    android:exported="false"
    android:foregroundServiceType="mediaPlayback">
    <intent-filter>
        <action android:name="android.intent.action.MEDIA_BUTTON" />
    </intent-filter>
</service>

<!-- Routes hardware/Bluetooth media-button presses (and the notification's
     own action buttons) into MediaPlaybackService's MediaSessionCompat -->
<receiver
    android:name="androidx.media.session.MediaButtonReceiver"
    android:exported="true">
    <intent-filter>
        <action android:name="android.intent.action.MEDIA_BUTTON" />
    </intent-filter>
</receiver>
